# --- LLM provider ---
# google  = Google AI Studio / Gemini API (Gemma models are served here)
# openai  = any OpenAI-compatible server (Ollama, vLLM, OpenRouter, LM Studio...)
# mock    = no API calls, canned responses (frontend dev + tests)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemma-4
# Leave blank to use the provider default.
#   google default: https://generativelanguage.googleapis.com/v1beta
#   openai example: http://localhost:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2

# --- Server ---
# Comma-separated list, or * for everything (fine for a hackathon)
CORS_ORIGINS=*
CHAT_MAX_MESSAGES=20
MAX_CODE_CHARS=20000
